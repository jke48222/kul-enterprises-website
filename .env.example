# Copy to .env.local for development. In production these are set in the
# Vercel project's Environment Variables — never commit real values.

# --- Email delivery (required in production) -------------------------------
# Resend API key. Without it, production form submissions FAIL VISIBLY
# (by design — a silently dropped lead is worse than an error message).
# In development, leaving it unset stubs the send and logs it instead.
RESEND_API_KEY=

# Optional lead redundancy: every form submission is also POSTed here as
# JSON (e.g. a Zapier/Make webhook feeding a Google Sheet).
LEAD_WEBHOOK_URL=

# --- Google (set at launch) -------------------------------------------------
# GA4 measurement id (G-XXXXXXXXXX), created under the client's account.
NEXT_PUBLIC_GA_ID=

# Search Console HTML-tag verification token (content="..." value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- TinaCMS (production editing via Tina Cloud) ----------------------------
# From app.tina.io after connecting the GitHub repo (free tier).
# Local editing needs neither: `npm run dev:cms` works self-contained.
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=
# Branch the CMS edits against; defaults to the deployed branch, then main.
NEXT_PUBLIC_TINA_BRANCH=
